class Solution {
    public String compressedString(String word) {
        int n = word.length();
        StringBuilder ans = new StringBuilder();
        int count = 1;
        for(int i=0;i<n;i++){
            if(i<n-1 && word.charAt(i)==word.charAt(i+1) && count<9){
                count++;
            }
            else{
                ans.append(count);
                ans.append(word.charAt(i));
                count=1;
            }
        }
        return ans.toString();
    }
}