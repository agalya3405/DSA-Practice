import java.util.*;

class Main {
    public static void main(String[] args) {
       Scanner sc = new Scanner(System.in);
        String st = sc.next();

        int[] freq = new int[26];
        int n = st.length();
        for(int i=0;i<n;i++){
            char ch = st.charAt(i);
            freq[ch - 'a']++;
        }
        for(int i = 0;i<26;i++){
            if(freq[i]>1){
                System.out.print("['" + (char)(i+97) + "':" + freq[i] + "]");
            }
        }
    }
}