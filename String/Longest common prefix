class Solution {
    public String longestCommonPrefix(String[] strs) {
       StringBuilder ans = new StringBuilder();
        int i = 0;
        while(i<strs[0].length()){
            char ch = strs[0].charAt(i);
            int idx = i;
           
            for(int j = 1;j<strs.length;j++){
                if(idx >= strs[j].length() || strs[j].charAt(idx)!=ch) {
                   return ans.toString();
                }
            }
           ans.append(ch);
            i++;
        }
        return ans.toString();
    }
}