class Solution {
    public int maxConsecutiveAnswers(String answerKey, int k) {
        int n = answerKey.length();
        int[] freq = new int[26];
        int maxi = 0;
        int l = 0;
        int maxLen = 0;
        for(int i=0;i<n;i++){
           char ch = answerKey.charAt(i);
            freq[ch - 'A']++;
            maxi = Math.max(maxi, freq[ch-'A']);

            while((i-l+1)-maxi > k){
                char c = answerKey.charAt(l);
                freq[c -'A']--;
                l++;
            }
        maxLen = Math.max(maxLen,(i-l+1));
        }
        return maxLen;
    }
}